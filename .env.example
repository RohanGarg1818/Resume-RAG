# Backend (FastAPI) — copy to .env
GROQ_API_KEY=your-groq-api-key

# Deployed frontend origin (no trailing slash needed; it is normalised).
FRONTEND_URL=https://rohan-resume-three.vercel.app

# Optional: extra comma-separated origins allowed to call the API with cookies.
# '*' is rejected because the session cookie requires explicit origins.
# CORS_ALLOWED_ORIGINS=http://localhost:4000

# Local dev origins (localhost/127.0.0.1 on ports 3000, 3001, 5173) are allowed
# by default. Set to false in production.
# CORS_ALLOW_LOCALHOST=false
